<?xml version="1.0"?>
<ruleset name="NExT-Block-Transporter">
	<description>NExT Block Transporter の PHP_CodeSniffer 設定。</description>

	<file>.</file>

	<!-- 依存関係・ビルド成果物・CI設定は検査対象外とする。 -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/.github/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/>

	<!-- 対応する最低WordPressバージョン(非推奨関数チェック等で参照される)。 -->
	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress">
		<!-- コメントは日本語(文末「。」)で記載するため、ASCIIの [.!?] を文末に要求するスニフは除外する。 -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<!-- 括弧を含む日本語コメントがコメントアウトされたコードと誤判定されるため除外する。 -->
		<exclude name="Squiz.PHP.CommentedOutCode.Found"/>
	</rule>

	<!-- 翻訳関数のテキストドメインをチェックする。 -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="next-block-transporter"/>
			</property>
		</properties>
	</rule>

	<!-- ZipArchive など PHP 標準クラスのプロパティ(numFiles 等)は snake_case 対象外とする。 -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="numFiles"/>
			</property>
		</properties>
	</rule>
</ruleset>
